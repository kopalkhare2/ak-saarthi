# Copy this file to .env and fill in values as needed.

# Required by the Prisma CLI (migrate/seed/studio). The running app itself
# always reads/writes prisma/dev.db directly (see lib/prisma.ts) regardless
# of this value, but the CLI commands need it set.
DATABASE_URL="file:./prisma/dev.db"

# Optional. Falls back to an insecure development secret if unset — the app
# will refuse to start in production without this set.
JWT_SECRET="a-long-random-string"

# Optional. Enables the real Gemini-powered AI assistant at /advisor/ai.
# Without it, /api/ai falls back to a local rule-based mock response generator.
GEMINI_API_KEY="your-google-gemini-api-key"
