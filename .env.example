# ─── AK Saarthi Environment Variables ───────────────────
# Copy this file to .env and fill in your database password.

# ─── Supabase / PostgreSQL Database ─────────────────────
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:[YOUR_DATABASE_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_ID:[YOUR_DATABASE_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# ─── Admin Configuration ────────────────────────────────
ADMIN_EMAIL="admin@example.com"

# ─── JWT Secret ──────────────────────────────────────────
JWT_SECRET="generate-a-strong-secret-or-use-default"

# ─── Gemini AI (Optional) ────────────────────────────────
# GEMINI_API_KEY="your-google-gemini-api-key"
