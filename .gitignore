# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# database files (no longer used — app now uses Supabase PostgreSQL)
prisma/dev.db
prisma/dev.db-journal
prisma/requests.json
prisma/advisors.json
# build-time migration artifact (generated by prisma migrate deploy during Vercel build)
prisma/seed.db
prisma/seed.db-journal

# uploaded client documents (persistent on server, not in repo)
/uploads/

# database backups
/backups/
